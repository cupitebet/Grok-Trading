# Salin ke .env lalu isi. Jangan commit .env.
POSTGRES_PASSWORD=ganti-dengan-password-kuat
DATABASE_URL=postgresql://gse:ganti-dengan-password-kuat@localhost:5432/gse

# X API v2 (Bearer Token dari developer.x.com)
X_BEARER_TOKEN=
# Maks halaman (100 tweet/halaman) per aset per run. Lebih besar = sampel lebih lengkap, kuota lebih boros.
X_MAX_PAGES=2
METRIC_DELAY_MINUTES=60

# xAI API (console.x.ai). Cek nama model terbaru di docs.x.ai lalu pin versi spesifik.
XAI_API_KEY=
GROK_MODEL=grok-4

# Ganti ke https://data-api.binance.vision jika server berada di lokasi yang diblokir Binance.
BINANCE_BASE_URL=https://api.binance.com
